# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Galaxy VOC Collector — 환경설정
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# [필수] HuggingFace 토큰 (Gemma 라이선스 동의 후 발급)
# 발급: https://huggingface.co/settings/tokens
HF_TOKEN=hf_여기에_토큰_입력

# [선택] 모델 캐시 경로 (기본: ~/.cache/huggingface)
# HF_HOME=./models

# [선택] 4bit 양자화 사용 여부 (VRAM 절약, 기본: true)
USE_4BIT=true

# [선택] GPU 사용 여부 (false면 CPU, 매우 느림)
USE_GPU=true
